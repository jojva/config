CanonicalizeHostname yes
CanonicalDomains algolia.net algolia.com cells.algolia.net

Host *.algolia.com *.algolia.net
  User jvalette
  CASignatureAlgorithms ecdsa-sha2-nistp256,ecdsa-sha2-nistp384,ecdsa-sha2-nistp521,ssh-ed25519,rsa-sha2-512,rsa-sha2-256,ssh-rsa

Host *.*.cells.algolia.net !jumphost.*.cells.algolia.net
  ProxyCommand bash -c 'ssh -W [%h]:%p jumphost.$(echo %h |cut -d. -f2-)'

Host *.logs-*.algolia.net !jumphost1.logs-*.algolia.net !collector*.logs-*.algolia.net
  ProxyCommand bash -c 'ssh -W [%h]:%p jumphost1.$(echo %h |cut -d. -f2-)'

Host github.com
  # GitHub key, in 1Password
  IdentityFile ~/.ssh/github.pub
  IdentitiesOnly yes

Match final user jvalette exec "/Users/joris.valette/bin/ssh-signer-client -c -d"
  CertificateFile ~/.ssh/jvalette-cert.pub
  # LDAP key, in 1Password: its public key tells the agent which one to use
  IdentityFile ~/.ssh/algolia.pub
  IdentitiesOnly yes

# Keys stored in 1Password, through its SSH agent (added by 1Password when turning
# the agent on)
Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
